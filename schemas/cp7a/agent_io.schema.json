{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ca3.local/schemas/cp7a/agent_io.schema.json",
  "title": "CA3 Lead and Assistant messages",
  "oneOf": [
    {"$ref": "#/$defs/lead_proposal"},
    {"$ref": "#/$defs/assistant_verification"}
  ],
  "$defs": {
    "lead_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "action_type", "reason_code", "community_ids", "evidence_ids"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "action_type": {"enum": ["propose_retain", "propose_remove", "propose_stage_claim", "open_gap", "request_verification", "request_bridge", "request_scope_extension", "recommend_stop"]},
        "reason_code": {"type": "string", "minLength": 1},
        "community_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "gap_id": {"type": ["string", "null"]},
        "attack_technique_ids": {"type": "array", "items": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}, "uniqueItems": true}
      }
    },
    "lead_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "investigation_id", "round", "input_snapshot_hash", "actions"],
      "properties": {
        "schema_version": {"const": "cp7a-1"},
        "message_type": {"const": "lead_proposal"},
        "investigation_id": {"type": "string", "minLength": 1},
        "round": {"type": "integer", "minimum": 0},
        "input_snapshot_hash": {"type": "string", "minLength": 16},
        "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lead_action"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "assistant_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "investigation_id", "round", "task_id", "verdict", "supporting_evidence_ids", "conflicting_evidence_ids", "scope_complete"],
      "properties": {
        "schema_version": {"const": "cp7a-1"},
        "message_type": {"const": "assistant_verification"},
        "investigation_id": {"type": "string", "minLength": 1},
        "round": {"type": "integer", "minimum": 0},
        "task_id": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["supported", "refuted", "unknown"]},
        "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "conflicting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "scope_complete": {"type": "boolean"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
