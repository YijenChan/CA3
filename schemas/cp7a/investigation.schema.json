{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ca3.local/schemas/cp7a/investigation.schema.json",
  "title": "CA3 Investigation Ledger events and Campaign Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "investigation_id", "ledger", "snapshot"],
  "properties": {
    "schema_version": {"const": "cp7a-1"},
    "investigation_id": {"type": "string", "minLength": 1},
    "ledger": {"type": "array", "items": {"$ref": "#/$defs/ledger_event"}},
    "snapshot": {"$ref": "#/$defs/snapshot"}
  },
  "$defs": {
    "evidence_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_type", "status", "community_ids", "evidence_ids"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "claim_type": {"enum": ["attack_stage", "initial_compromise", "backbone_transition", "entity_role", "bridge"]},
        "status": {"enum": ["proposed", "supported", "refuted", "unknown"]},
        "community_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "attack_technique_ids": {"type": "array", "items": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}, "uniqueItems": true}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_id", "gap_type", "critical", "status", "reason_code"],
      "properties": {
        "gap_id": {"type": "string", "minLength": 1},
        "gap_type": {"enum": ["evidence_integrity", "connectivity", "entry", "stage_constraint", "left_time", "right_time", "host_scope", "competition"]},
        "critical": {"type": "boolean"},
        "status": {"enum": ["open", "closed", "blocked"]},
        "reason_code": {"type": "string", "minLength": 1},
        "endpoint_community_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 2},
        "required_evidence_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "ledger_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "event_id", "event_type", "round", "actor", "input_snapshot_hash", "payload_hash"],
      "properties": {
        "offset": {"type": "integer", "minimum": 0},
        "event_id": {"type": "string", "minLength": 1},
        "event_type": {"enum": ["claim_proposed", "claim_supported", "claim_refuted", "gap_opened", "gap_updated", "gap_closed", "task_issued", "verification_recorded", "bridge_query_issued", "bridge_candidate_retrieved", "bridge_candidate_accepted", "bridge_candidate_rejected", "scope_extension_requested", "stop_recorded"]},
        "round": {"type": "integer", "minimum": 0},
        "actor": {"enum": ["controller", "lead", "assistant", "retriever"]},
        "input_snapshot_hash": {"type": "string", "minLength": 16},
        "payload_hash": {"type": "string", "minLength": 16},
        "claim": {"$ref": "#/$defs/evidence_claim"},
        "gap": {"$ref": "#/$defs/gap"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reason_code": {"type": "string"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_offset", "backbone_community_ids", "backbone_edge_ids", "claims", "open_gaps", "next_action", "snapshot_hash"],
      "properties": {
        "ledger_offset": {"type": "integer", "minimum": -1},
        "backbone_community_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "backbone_edge_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/evidence_claim"}},
        "open_gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
        "next_action": {"enum": ["verify_claim", "retrieve_bridge", "extend_left", "extend_right", "extend_host", "stop_complete", "stop_limited"]},
        "action_reason_gap_id": {"type": ["string", "null"]},
        "snapshot_hash": {"type": "string", "minLength": 16}
      }
    }
  }
}
